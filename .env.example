# ==============================================================================
# SHASHWAT HOSPITAL — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production hosting (e.g., Vercel, Netlify, or Node server), set these
# variables in your project settings dashboard.
# NEVER commit real keys or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL DOMAIN & SEO CONFIGURATION
# ------------------------------------------------------------------------------
# Used for sitemap.xml, robots.txt, OpenGraph previews, and OAuth redirects.
# Local development: http://localhost:3000
# Production: https://www.shashwathospital.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION (CRITICAL)
# ------------------------------------------------------------------------------
# Required for real database persistence, staff role assignment, and patient portal.
# Retrieve from: Supabase Dashboard > Project Settings > API
#
# NEXT_PUBLIC_SUPABASE_URL is safe to expose to client browsers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe for browser queries (guarded by Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# SUPABASE_SERVICE_ROLE_KEY MUST REMAIN SECRET. NEVER PREFIX WITH NEXT_PUBLIC_.
# Grants full bypass of Row Level Security for administrative server endpoints.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT / TEST TOGGLE (DO NOT ENABLE IN PRODUCTION)
# ------------------------------------------------------------------------------
# When true, allows the in-memory fallback store to operate for local offline UI tests.
# Must remain false or omitted in live production deployments.
ALLOW_DEV_FALLBACK=false

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL NOTIFICATIONS (OPTIONAL - RESEND)
# ------------------------------------------------------------------------------
# Dispatches instant staff alerts when new appointment requests arrive.
RESEND_API_KEY=re_your_resend_api_key_placeholder
HOSPITAL_ALERT_EMAIL=appointments@shashwathospital.com
HOSPITAL_FROM_EMAIL=notifications@shashwathospital.com

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API NOTIFICATIONS (OPTIONAL - META GRAPH API)
# ------------------------------------------------------------------------------
# Dispatches confirmation SMS/WhatsApp tokens to patients upon booking.
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_placeholder
WHATSAPP_TEMPLATE_NAME=appointment_confirmation_template

# ------------------------------------------------------------------------------
# 6. AUTOMATED TEST SUITE CONFIGURATION
# ------------------------------------------------------------------------------
TEST_BASE_URL=http://localhost:3000
