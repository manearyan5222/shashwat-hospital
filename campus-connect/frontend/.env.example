# =============================================================================
# CampusConnect Frontend Environment Configuration
# =============================================================================

# Standalone Demo Mode (Default: true)
# When true, all API calls use local JSON mock data with in-memory session persistence.
VITE_DEMO_MODE=true

# Permanent Backend REST API Base URL (Used when VITE_DEMO_MODE=false)
# e.g., https://campusconnect-backend.onrender.com/api or /api
VITE_API_URL=/api
