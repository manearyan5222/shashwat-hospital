# =============================================================================
# CampusConnect Portal - Environment Configuration Template
# Copy this file to .env or configure these variables on your cloud host.
# =============================================================================

# Server Port (Default: 8080 or assigned dynamically by Render/Railway/Fly.io)
PORT=8080

# Active Spring Profile: 'mysql' (default), 'h2' (zero-config in-memory), or 'oracle'
SPRING_PROFILES_ACTIVE=h2

# Demo Account Passwords (Configurable securely via environment)
APP_ADMIN_PASSWORD=Admin@Campus2026!
APP_FACULTY_PASSWORD=Faculty@Campus2026!
APP_STUDENT_PASSWORD=Student@Campus2026!

# JWT Authentication Secret & Expiration (24 hours = 86400000 ms)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated, restricts access strictly to your deployed frontend)
CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://*.tmp.now,http://localhost:5173,http://localhost:3000

# Optional External MySQL Database Configuration (when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_connect
DB_USERNAME=root
DB_PASSWORD=root_password

# Optional Oracle Database Configuration (Only used when SPRING_PROFILES_ACTIVE=oracle)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USERNAME=c##campus_user
ORACLE_PASSWORD=oracle_password

# Frontend Environment Variable (set on Vercel)
# VITE_API_URL=https://campus-connect-backend.onrender.com/api
